{
  "name": "sai",
  "private": true,
  "version": "0.2.0",
  "repository": "https://github.com/Naturalclar/sai",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "start:watch": "node --watch --disable-warning=ExperimentalWarning server/main.ts",
    "dev": "vite web",
    "build": "pnpm typecheck && vite build web",
    "preview": "vite preview web",
    "test": "node --test --disable-warning=ExperimentalWarning \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "test:feed": "python3 -m unittest feed.test_record",
    "lint": "oxlint web/src server shared",
    "typecheck": "tsc -p web && tsc -p server"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
